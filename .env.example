# ─────────────────────────────────────────────────────────────────────────────
# Worldsmith — environment template
#
# Copy to .env.local and fill in. Every variable below is read somewhere in the
# codebase; anything the code does not read has been removed from this file.
#
# Set every *_PROVIDER to "mock" to explore the whole product without spending
# anything at a provider. Only NEXT_PUBLIC_* values reach the browser — keep all
# keys and service-account material out of that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Providers ────────────────────────────────────────────────────────────────
# Each accepts "mock" for offline development. Every real model is a Google
# model: gemini (API key) or vertex (service account).
LLM_PROVIDER=vertex              # mock | gemini | vertex
IMAGE_PROVIDER=vertex            # mock | vertex | gemini | pollinations
VIDEO_PROVIDER=vertex            # mock | vertex  (Veo)
VLM_PROVIDER=vertex              # mock | vertex  (continuity QC)
AUDIO_PROVIDER=vertex            # mock | vertex  (Gemini TTS)
DISTRIBUTION_PROVIDER=vertex     # mock | vertex  (campaign copy)
RESEARCH_PROVIDER=parallel       # mock | parallel

# ── Google Cloud / Vertex AI ─────────────────────────────────────────────────
VERTEX_PROJECT_ID=your-gcp-project
VERTEX_LOCATION=us-central1
# Path to a service-account JSON file. Never commit the file itself.
VERTEX_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Only needed when LLM_PROVIDER or IMAGE_PROVIDER is "gemini" (API-key mode).
# GOOGLE_API_KEY=

# ── Parallel (research) ──────────────────────────────────────────────────────
# Required when RESEARCH_PROVIDER=parallel.
PARALLEL_API_KEY=your-parallel-key

# ── Firebase (client SDK — these are public by design) ───────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server) ──────────────────────────────────────────────────
# Supply ONE of these. The JSON form suits hosts where you cannot ship a file.
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ── App ──────────────────────────────────────────────────────────────────────
# Absolute origin. Used to build payment return URLs and to resolve stored
# asset URIs server-side, so it must be correct in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The single account allowed to manage promo codes.
OWNER_EMAIL=you@example.com

# ── Billing (Dodo Payments) ──────────────────────────────────────────────────
DODO_MODE=test                   # test | live
DODO_API_KEY=
# Signing secret from the Dodo dashboard — NOT a webhook URL.
DODO_WEBHOOK_SECRET=
# JSON maps, keyed "plan:<id>:<cycle>" or "pack:<id>".
DODO_PRODUCT_IDS={}
DODO_PRODUCT_MAP={}
DODO_PAYMENT_LINKS={}

# ── Optional tuning ──────────────────────────────────────────────────────────
# Model overrides — leave unset to use the built-in defaults.
# VERTEX_LLM_MODEL=
# VERTEX_IMAGE_MODEL=
# IMAGE_MODEL=
# VEO_MODEL=veo-3.1-generate-001
# VLM_MODEL=
# TTS_MODEL=
# DISTRIBUTION_MODEL=

# Unit-cost overrides, used for the per-asset cost ledger. Defaults match
# current Google list pricing; change them if your rates differ.
# VERTEX_IMAGE_COST_USD=0.039
# VEO_COST_PER_SECOND=0.40
# VLM_COST_USD=
# TTS_COST_USD=

# Milliseconds between consecutive generations, to stay under per-minute quota.
# GEN_PACING_MS=2500

# Forces a fixed QC verdict. Development only.
# MOCK_QC_RESULT=

# Legacy fallback for OWNER_EMAIL, kept for an older project-claim migration.
# LEGACY_OWNER_EMAIL=
